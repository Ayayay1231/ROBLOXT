#include <Servo.h>
Servo myservo;
Servo ser2; //ประกาศตัวแปรแทน Servo
void setup()
{
  myservo.attach(9);
  ser2.attach(11);
   // กำหนดขา 9 ควบคุม Servo
}
void loop()
{
  myservo.write(0);
  ser2.write(0); // สั่งให้ Servo หมุนไปองศาที่ 0
  delay(1000); 
  // หน่วงเวลา 1000ms
  myservo.write(45);
  ser2.write(45); // สั่งให้ Servo หมุนไปองศาที่ 45
  delay(1000);
   // หน่วงเวลา 1000ms
  myservo.write(60);
  ser2.write(30); // สั่งให้ Servo หมุนไปองศาที่ 90
  delay(1000); // หน่วงเวลา 1000ms
}
